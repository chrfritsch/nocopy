# Thread-safe PHP (what FrankenPHP and threaded Apache use), with ext-parallel for the threaded tests:
#   docker build --build-arg PHP=8.4 -f docker/Dockerfile.zts -t nocopy-zts:8.4 docker
#   docker run --rm -v "$PWD":/src:ro nocopy-zts:8.4 /src/docker/test.sh
ARG PHP=8.4
FROM php:${PHP}-zts
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev pkg-config && rm -rf /var/lib/apt/lists/* \
 && docker-php-ext-install pcntl && pecl install parallel && docker-php-ext-enable parallel
