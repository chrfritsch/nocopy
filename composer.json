{
    "name": "lab/stash",
    "type": "php-ext",
    "license": "proprietary",
    "description": "Zero-copy shared-memory cache for PHP, drop-in for APCu (apcu_* API, APCUIterator, apc.* INI)",
    "require": {
        "php": ">=8.3"
    },
    "php-ext": {
        "extension-name": "stash",
        "configure-options": [
            {
                "name": "enable-stash",
                "needs-value": false,
                "description": "Enable stash support"
            }
        ]
    }
}
