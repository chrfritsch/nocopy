{
    "name": "chrfritsch/nocopy",
    "type": "php-ext",
    "license": "MIT",
    "description": "Zero-copy shared-memory cache for PHP, drop-in for APCu (apcu_* API, APCUIterator, apc.* INI)",
    "require": {
        "php": ">=8.3"
    },
    "php-ext": {
        "extension-name": "nocopy",
        "configure-options": [
            {
                "name": "enable-nocopy",
                "needs-value": false,
                "description": "Enable nocopy support"
            }
        ]
    }
}
