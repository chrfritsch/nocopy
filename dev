#!/bin/sh
# One entry point for building, testing and benchmarking. Everything runs in Docker (Linux), the same commands CI runs.
set -e
cd "$(dirname "$0")"
PHP=${PHP:-8.5}
[ -t 0 ] && [ -t 1 ] && TTY=-it || TTY=

usage() { cat <<EOF
Usage: [PHP=8.4|8.5] ./dev <command> [args]     (default PHP=$PHP; images are built on first use, cached after)

  test [tests/0xx.phpt ...]   build + .phpt suite (Valkey tests included)
  novalkey [tests ...]        same, built with --disable-nocopy-valkey
  asan [tests ...]            same, built with ASan + UBSan
  clang [tests ...]           same, built with clang
  zts [tests ...]             suite on thread-safe PHP 8.4 (ext-parallel)
  stress [loops=30]           concurrency tests in a loop, stops at first failure
  c [seconds=3]               arena alone from 8 threads, plain + ThreadSanitizer
  fuzz [iterations=20000] [seed]  random values round-tripped under ASan, copy + zero-copy (seed printed: replays the run)
  shm                         CLI + php-fpm share one cache by name, then with Valkey
  frankenphp                  FrankenPHP classic + worker mode, and shm with it
  symfony [version=8.*]       Symfony bundle smoke test (alone and next to APCu)
  apcu                        APCu's own suite against the polyfill (13 known failures)
  drupal                      Drupal module's PHPUnit tests in 3 cache modes
  tidy                        clang-tidy over the C sources (.clang-tidy)
  ci                          everything above (what CI runs, one PHP version)

  bench [groups]              micro benchmarks vs APCu (ONLY=regex: those measurements only)
  ab [ref=main] [reps=3] [groups]  A/B: ref vs working tree, interleaved, best of reps (ONLY=regex)
  sfbench                     Symfony app (bench/sfapp) under nginx + fpm, APCu vs nocopy (WORKERS, REQS, CONC)
  stampede [workers secs ttl ms]
  drupal-bench                Drupal under nginx + fpm, 9 cache configs (long; MEM_ONLY=1 memory, PERF_ONLY=1 perf profile; CONFIGS=...)
  perf [ops...]               perf profile of bench/prof.php loops, copy + zero mode (OPS, MODES, ANNOTATE="syms" by line; .cache/perf)
  hitratio                    hit ratios of nocopy, APCu and Valkey at equal memory (~20 min)

  stub                        regenerate nocopy_arginfo.h from nocopy.stub.php
  shell                       bash in the image with nocopy built and loaded (php -m, php -a)
  image                       (re)build the images for \$PHP
EOF
}

img() { docker build -q --build-arg PHP="$PHP" -t "nocopy-linux:$PHP" docker >/dev/null; }
run() { docker run --rm $TTY -v "$PWD":/src:ro "$@"; }

cmd=${1:-help}; [ $# -gt 0 ] && shift
case $cmd in
  test)       img; run "nocopy-linux:$PHP" /src/docker/test.sh "$@" ;;
  novalkey)   img; run -e NOCOPY_CONFIGURE=--disable-nocopy-valkey "nocopy-linux:$PHP" /src/docker/test.sh "$@" ;;
  asan)       img; run -e NOCOPY_ASAN=1 "nocopy-linux:$PHP" /src/docker/test.sh "$@" ;;
  zts)        docker build -q --build-arg PHP=8.4 -f docker/Dockerfile.zts -t nocopy-zts:8.4 docker >/dev/null
              run nocopy-zts:8.4 /src/docker/test.sh "$@" ;;
  clang)      img; run -e CC=clang "nocopy-linux:$PHP" /src/docker/test.sh "$@" ;;
  tidy)       img; run "nocopy-linux:$PHP" /src/docker/tidy.sh ;;
  stress)     img; run "nocopy-linux:$PHP" /src/docker/stress.sh "${1:-30}" ;;
  c)          img; run "nocopy-linux:$PHP" /src/tests/c/run.sh "${1:-3}" ;;
  fuzz)       img; run -e FUZZ_VALUE "nocopy-linux:$PHP" /src/docker/fuzz.sh "$@" ;;
  shm)        img; run "nocopy-linux:$PHP" sh /src/docker/shm-name.sh ;;
  frankenphp) run dunglas/frankenphp:1-php8.4 sh /src/docker/frankenphp.sh
              run dunglas/frankenphp:1-php8.4 sh /src/docker/shm-name.sh ;;
  symfony)    v=${1:-8.*}; sf=.cache/sf-$PHP-$(echo "$v" | tr -d '.*')
              if [ ! -d "$sf/vendor" ]; then
                mkdir -p "$sf" && echo "{\"config\":{\"platform\":{\"php\":\"$PHP.0\"}}}" > "$sf/composer.json"
                docker run --rm -v "$PWD/$sf":/app -w /app composer:2 require -q '--ignore-platform-req=ext-*' "symfony/framework-bundle:$v"
              fi
              img; run -v "$PWD/$sf":/sf:ro "nocopy-linux:$PHP" /src/docker/symfony.sh ;;
  apcu)       img; run "nocopy-linux:$PHP" sh -c '/src/docker/build.sh >/dev/null && /src/scripts/apcu-suite.sh' ;;
  drupal)     PHP=8.5; img; docker build -q -t nocopy-drupal -f docker/Dockerfile.drupal docker >/dev/null
              run -v nocopy-drupal-test:/drupal nocopy-drupal /src/docker/drupal-test.sh ;;
  ci)         for c in tidy test novalkey asan clang stress c fuzz shm zts frankenphp symfony; do
                echo "== $c"; ./dev "$c" || { echo "== $c FAILED"; exit 1; }
              done; echo "== ci: all passed" ;;
  bench)      img; run --shm-size=1g -e ONLY "nocopy-linux:$PHP" /src/docker/bench.sh "$@" ;;
  ab)         ref=${1:-main}; [ $# -gt 0 ] && shift; a=.cache/ab-old; rm -rf "$a" && mkdir -p "$a" && git archive "$ref" | tar -x -C "$a"
              img; run --shm-size=1g -e ONLY -v "$PWD/$a":/a:ro -v "$PWD":/b:ro "nocopy-linux:$PHP" /src/docker/ab.sh "${1:-3}" "${2:-read write parallel mixed contend ttl}" ;;
  sfbench)    a=.cache/sfapp; rm -rf "$a" && mkdir -p "$a/nocopy-bundle" && cp -r bench/sfapp/composer.json bench/sfapp/src bench/sfapp/public "$a/" && cp -r symfony/src "$a/nocopy-bundle/"
              docker run --rm -v "$PWD/$a":/app -w /app composer:2 install -q --no-dev --classmap-authoritative '--ignore-platform-req=ext-*'
              img; run --shm-size=1g -e WORKERS -e REQS -e CONC -v "$PWD/$a":/appsrc:ro "nocopy-linux:$PHP" /src/docker/fpm-bench.sh ;;
  stampede)   img; run "nocopy-linux:$PHP" /src/docker/stampede.sh "$@" ;;
  perf)       img; docker build -q --build-arg PHP="$PHP" -f docker/Dockerfile.perf -t "nocopy-perf:$PHP" docker >/dev/null; mkdir -p .cache/perf
              run --privileged --shm-size=1g -e OPS="${*:-$OPS}" -e MODES -e ANNOTATE -e TOP -v "$PWD/.cache/perf":/out "nocopy-perf:$PHP" /src/docker/perf.sh ;;
  hitratio)   PHP=8.5; img; docker build -q -t nocopy-drupal -f docker/Dockerfile.drupal docker >/dev/null
              run --shm-size=1g nocopy-drupal /src/docker/hitratio-compare.sh ;;
  drupal-bench) PHP=8.5; img; docker build -q -t nocopy-drupal -f docker/Dockerfile.drupal docker >/dev/null
              run --shm-size=1g --cap-add=SYS_PTRACE ${PERF_ONLY:+--privileged} -e MEM_ONLY -e PERF_ONLY -e TRACE_ONLY -e PERF_N -e CONFIGS -v nocopy-drupal-bench:/site -v "$PWD/bench/results-drupal":/out nocopy-drupal /src/docker/drupal-bench.sh ;;
  shell)      img; docker run --rm -it -v "$PWD":/src:ro "nocopy-linux:$PHP" sh -c \
                '/src/docker/build.sh && printf "extension=/build/modules/nocopy.so\nnocopy.shm_name=/nocopy-shell\n" > /usr/local/etc/php/conf.d/zz-nocopy.ini && cd /src && exec bash' ;;
  stub)       img; docker run --rm -v "$PWD":/src -w /src "nocopy-linux:$PHP" php /usr/local/lib/php/build/gen_stub.php nocopy.stub.php ;;
  image)      img; echo "nocopy-linux:$PHP ready" ;;
  help|-h|--help) usage ;;
  *)          usage >&2; exit 1 ;;
esac
