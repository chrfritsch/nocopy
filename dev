#!/bin/sh
# One entry point for building, testing and benchmarking. Everything runs in Docker (Linux), the same commands CI runs.
set -e
cd "$(dirname "$0")"
PHP=${PHP:-8.5}
[ -t 0 ] && [ -t 1 ] && TTY=-it || TTY=

usage() { cat <<EOF
Usage: [PHP=8.4|8.5] ./dev <command> [args]     (default PHP=$PHP; images are built on first use, cached after)

  test [tests/0xx.phpt ...]   build + .phpt suite (RESP tests included)
  noresp [tests ...]        same, built with --disable-nocopy-resp
  asan [tests ...]            same, built with ASan + UBSan and nocopy's own assertions
  debug [tests ...]           same as asan, on a debug build of PHP (the engine's assertions; built once, cached); debug fuzz [...]: the fuzzer there
  leaks [tests ...]           suite on the debug PHP without ASan, Zend allocator on: memory a request leaks fails the test; leaks fuzz [...]: the fuzzer there
  clang [tests ...]           same, built with clang
  zts [tests ...]             suite on thread-safe PHP 8.4 (ext-parallel)
  stress [loops=30]           concurrency tests in a loop, stops at first failure
  c [seconds=3]               arena alone from 8 threads, plain + ThreadSanitizer
  fuzz [iterations=20000] [seed]  random values round-tripped under ASan, copy + zero-copy (seed printed: replays the run)
  shm                         CLI + php-fpm, then CLI + Apache mod_php share one cache by name (fpm also with RESP)
  frankenphp                  FrankenPHP classic + worker mode, and shm with it
  pie                         pie install from the committed tree, with and without each configure option
  symfony [version=8.*]       Symfony bundle smoke test (alone and next to APCu)
  apcu                        APCu's own suite against the polyfill (13 known failures)
  drupal                      Drupal module's PHPUnit tests in 3 cache modes
  tidy                        clang-tidy over the C sources (.clang-tidy)
  layers                      the arena's include and naming boundaries (scripts/check-layers.sh)
  ci                          everything above but drupal (what CI runs, one PHP version)

  bench [groups]              micro benchmarks vs APCu (ONLY=regex: those measurements only)
  ab [ref=main] [reps=3] [groups]  A/B: ref vs working tree, interleaved, best of reps (ONLY=regex)
  fpbench                     same Symfony app in FrankenPHP worker mode (copy mode), APCu vs nocopy vs PHP files (WORKERS, REQS, CONC)
  sfbench                     Symfony app (bench/sfapp) under nginx + fpm, APCu vs nocopy (WORKERS, REQS, CONC)
  stampede [workers secs ttl ms]
  opcache                     nocopy vs values as PHP files in OPcache (PhpFilesAdapter's mechanism), zero-copy both
  big [sizes="1G 4G"] [secs=20]  large arenas: create/attach time, fill, eviction pauses (needs RAM for the arena)
  soak [minutes=60] [workers=8] [interval_s=30]  long mixed workload, one line per interval to spot drift
  tail [workers=8] [secs=10] [scenarios]  get/put latency percentiles (p50..p99.99, max) under eviction and contention, vs APCu
  sfget [bundle src dir]      Symfony bundle's get() vs AbstractAdapter's, and its PSR-6 reads, in ns per call (bench/sfget.php; after ./dev symfony)
  drupal-get                  Drupal backend's get()/getMultiple() in ns per call (bench/drupal/get.php; after ./dev drupal)
  drupal-bench                Drupal under nginx + fpm, 9 cache configs (long; MEM_ONLY=1 memory, ROWS_ONLY=1 its DB cache rows in an arena, PERF_ONLY=1 perf profile; CONFIGS=...)
  cg [ops...]                 cachegrind instructions per op of bench/prof.php (N, TOP, ANNOTATE=1; .cache/perf)
  perf [ops...]               perf profile of bench/prof.php loops, copy + zero mode (OPS, MODES, ANNOTATE="syms" by line; .cache/perf)
  hitratio                    hit ratios of nocopy, APCu and RESP at equal memory (~20 min)
  trace [raw.csv...]          Twitter traces with TTLs replayed read-through: nocopy vs libCacheSim's policies at equal bytes (SIZES, ALGOS, N; traces in .cache/traces, see docker/trace.sh)

  stub                        regenerate nocopy_arginfo.h from nocopy.stub.php
  shell                       bash in the image with nocopy built and loaded (php -m, php -a)
  image                       (re)build the images for \$PHP
EOF
}

# img [flavour]: nocopy-linux:$PHP, and on top of it nocopy-<flavour> from docker/Dockerfile.<flavour> (debug, perf: per PHP; drupal, trace: PHP 8.5)
img() {
  docker build -q --build-arg PHP="$PHP" -t "nocopy-linux:$PHP" docker >/dev/null
  case $1 in
    debug|perf)   docker build -q --build-arg PHP="$PHP" -f "docker/Dockerfile.$1" -t "nocopy-$1:$PHP" docker >/dev/null ;;
    drupal|trace) docker build -q -f "docker/Dockerfile.$1" -t "nocopy-$1" docker >/dev/null ;;
  esac
}
run() { docker run --rm --shm-size=1g $TTY -v "$PWD":/src:ro "$@"; }
# In the image: the start of an sh -c snippet that builds nocopy with docker/lib.sh loaded (SO, nocopy_flags, shm_rm)
B='. /src/docker/lib.sh; /src/docker/build.sh >/dev/null'
# bench/sfapp with the bundle and its vendor/ in .cache/sfapp
sfapp() {
  a=.cache/sfapp; rm -rf "$a" && mkdir -p "$a/nocopy-bundle" && cp -r bench/sfapp/composer.json bench/sfapp/src bench/sfapp/public "$a/" && cp -r symfony/src "$a/nocopy-bundle/"
  docker run --rm -v "$PWD/$a":/app -w /app composer:2 install -q --no-dev --classmap-authoritative '--ignore-platform-req=ext-*'
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
case $cmd in
  test)       img; run "nocopy-linux:$PHP" /src/docker/test.sh "$@" ;;
  noresp)   img; run -e NOCOPY_CONFIGURE=--disable-nocopy-resp "nocopy-linux:$PHP" /src/docker/test.sh "$@" ;;
  asan)       img; run -e NOCOPY_ASAN=1 "nocopy-linux:$PHP" /src/docker/test.sh "$@" ;;
  debug)      img debug
              if [ "$1" = fuzz ]; then shift; run -e FUZZ_VALUE "nocopy-debug:$PHP" /src/docker/fuzz.sh "$@"
              else run -e NOCOPY_ASAN=1 "nocopy-debug:$PHP" /src/docker/test.sh "$@"; fi ;;
  leaks)      img debug
              if [ "$1" = fuzz ]; then shift; run -e FUZZ_VALUE -e NOCOPY_LEAKS=1 "nocopy-debug:$PHP" /src/docker/fuzz.sh "$@"
              else run -e NOCOPY_CFLAGS=-DNOCOPY_DEBUG "nocopy-debug:$PHP" /src/docker/test.sh "$@"; fi ;;
  zts)        docker build -q --build-arg PHP=8.4 -f docker/Dockerfile.zts -t nocopy-zts:8.4 docker >/dev/null
              run nocopy-zts:8.4 /src/docker/test.sh "$@" ;;
  clang)      img; run -e CC=clang "nocopy-linux:$PHP" /src/docker/test.sh "$@" ;;
  layers)     scripts/check-layers.sh ;;
  tidy)       img; run "nocopy-linux:$PHP" /src/docker/tidy.sh ;;
  stress)     img; run "nocopy-linux:$PHP" /src/docker/stress.sh "${1:-30}" ;;
  c)          img; run "nocopy-linux:$PHP" /src/tests/c/run.sh "${1:-3}" ;;
  fuzz)       img; run -e FUZZ_VALUE "nocopy-linux:$PHP" /src/docker/fuzz.sh "$@" ;;
  shm)        img; run "nocopy-linux:$PHP" sh /src/docker/shm-name.sh && run "php:$PHP-apache" sh /src/docker/shm-name.sh ;;
  pie)        img; p=.cache/pie-1.5.5  # fetched once: a binary rewritten just before the mount sometimes shows as not found
              [ -x $p ] || { mkdir -p .cache; c=$(docker create ghcr.io/php/pie:1.5.5-bin x) && docker cp -q "$c":/pie $p.tmp && docker rm "$c" >/dev/null && mv $p.tmp $p; } || exit 1
              run -v "$PWD/$p":/usr/local/bin/pie:ro "nocopy-linux:$PHP" /src/docker/pie.sh ;;
  frankenphp) run dunglas/frankenphp:1-php8.4 sh /src/docker/frankenphp.sh
              run dunglas/frankenphp:1-php8.4 sh /src/docker/shm-name.sh ;;
  symfony)    v=${1:-8.*}; sf=.cache/sf-$PHP-$(echo "$v" | tr -d '.*')
              if [ ! -d "$sf/vendor" ]; then
                mkdir -p "$sf" && echo "{\"config\":{\"platform\":{\"php\":\"$PHP.0\"}}}" > "$sf/composer.json"
                docker run --rm -v "$PWD/$sf":/app -w /app composer:2 require -q '--ignore-platform-req=ext-*' "symfony/framework-bundle:$v"
              fi
              img; run -v "$PWD/$sf":/sf:ro "nocopy-linux:$PHP" /src/docker/symfony.sh ;;
  apcu)       img; run "nocopy-linux:$PHP" sh -c "$B && /src/scripts/apcu-suite.sh" ;;
  drupal)     PHP=8.5; img drupal
              run -v nocopy-drupal-test:/drupal nocopy-drupal /src/docker/drupal-test.sh ;;
  ci)         for c in layers tidy test noresp asan debug leaks clang stress c fuzz "debug fuzz" "leaks fuzz" shm pie zts frankenphp symfony apcu; do
                echo "== $c"; ./dev $c || { echo "== $c FAILED"; exit 1; }
              done; echo "== ci: all passed" ;;
  bench)      img; run --shm-size=1g -e ONLY "nocopy-linux:$PHP" /src/docker/bench.sh "$@" ;;
  ab)         ref=${1:-main}; [ $# -gt 0 ] && shift; a=.cache/ab-old; rm -rf "$a" && mkdir -p "$a" && git archive "$ref" | tar -x -C "$a"
              img; run --shm-size=1g -e ONLY -v "$PWD/$a":/a:ro -v "$PWD":/b:ro "nocopy-linux:$PHP" /src/docker/ab.sh "${1:-3}" "${2:-read write parallel mixed contend ttl}" ;;
  sfbench)    sfapp
              img; run --shm-size=1g -e WORKERS -e REQS -e CONC -v "$PWD/$a":/appsrc:ro "nocopy-linux:$PHP" /src/docker/fpm-bench.sh ;;
  opcache)    img; run --shm-size=1g "nocopy-linux:$PHP" sh -c "$B"' && NOCOPY_SO=$SO php -n $(nocopy_flags opc shm_size=256M) /src/bench/opcache.php; shm_rm opc' ;;
  big)        img; run --shm-size=9g "nocopy-linux:$PHP" sh -c "$B"'; N="-n -d extension=pcntl -d memory_limit=1G $(nocopy_flags big)"
              for m in ${1:-1G 4G}; do shm_rm big; s=$(date +%s%N); php $N -d nocopy.shm_size=$m -r "nocopy_stats();"; e=$(date +%s%N)
              echo "$m create: $(( (e - s) / 1000000 )) ms"; php $N -d nocopy.shm_size=$m /src/bench/big.php ${2:-20}; done; shm_rm big' big "$@" ;;
  soak)       img; run --shm-size=1g "nocopy-linux:$PHP" sh -c "$B"' && php -n -d extension=pcntl -d memory_limit=1G $(nocopy_flags soak shm_size=256M) /src/bench/soak.php "$@"; shm_rm soak' soak "$@" ;;
  tail)       img; run --shm-size=1g "nocopy-linux:$PHP" /src/docker/tail.sh "$@" ;;
  fpbench)    sfapp
              run --shm-size=1g -e WORKERS -e REQS -e CONC -v "$PWD/$a":/appsrc:ro dunglas/frankenphp:1-php8.5 sh /src/docker/fp-bench.sh ;;
  stampede)   img; run "nocopy-linux:$PHP" /src/docker/stampede.sh "$@" ;;
  cg)         img perf; mkdir -p .cache/perf
              run --privileged --shm-size=1g -e OPS="${*:-$OPS}" -e N -v "$PWD/.cache/perf":/out "nocopy-perf:$PHP" /src/docker/cg.sh ;;
  perf)       img perf; mkdir -p .cache/perf
              run --privileged --shm-size=1g -e OPS="${*:-$OPS}" -e MODES -e ANNOTATE -e TOP -v "$PWD/.cache/perf":/out "nocopy-perf:$PHP" /src/docker/perf.sh ;;
  hitratio)   PHP=8.5; img drupal
              run --shm-size=1g nocopy-drupal /src/docker/hitratio-compare.sh ;;
  trace)      PHP=8.5; img trace
              run -e SIZES -e ALGOS -e N nocopy-trace /src/docker/trace.sh "$@" ;;
  sfget)      img; run -v "$PWD/.cache/sf-$PHP-8":/sf:ro "nocopy-linux:$PHP" sh -c "$B"' && php -n $(nocopy_flags sfget) -d opcache.enable_cli=1 /src/bench/sfget.php /sf "$@"; rc=$?; shm_rm sfget; exit $rc' sfget "$@" ;;
  drupal-get) PHP=8.5; img drupal
              run -v nocopy-drupal-test:/drupal nocopy-drupal sh -c "$B"' && php $(nocopy_flags drupal-get) -d opcache.enable_cli=1 /src/bench/drupal/get.php /drupal "${1:-/src/drupal}"; rc=$?; shm_rm drupal-get; exit $rc' drupal-get "$@" ;;
  drupal-bench) PHP=8.5; img drupal
              run --shm-size=1g --cap-add=SYS_PTRACE ${PERF_ONLY:+--privileged} -e NOCOPY_CFLAGS -e MEM_ONLY -e ROWS_ONLY -e REPLAY -e PERF_ONLY -e TRACE_ONLY -e PERF_N -e CONFIGS -v nocopy-drupal-bench:/site -v "$PWD/bench/results-drupal":/out nocopy-drupal /src/docker/drupal-bench.sh ;;
  shell)      img; docker run --rm -it --shm-size=1g -v "$PWD":/src:ro "nocopy-linux:$PHP" sh -c \
                '/src/docker/build.sh && printf "extension=/build/modules/nocopy.so\nnocopy.shm_name=/nocopy-shell\n" > /usr/local/etc/php/conf.d/zz-nocopy.ini && cd /src && exec bash' ;;
  stub)       img; docker run --rm -v "$PWD":/src -w /src "nocopy-linux:$PHP" php /usr/local/lib/php/build/gen_stub.php nocopy.stub.php ;;
  image)      img; echo "nocopy-linux:$PHP ready" ;;
  help|-h|--help) usage ;;
  *)          usage >&2; exit 1 ;;
esac
